/**
 * ★ 能耗三档预设（固定值，改动任意滑条即进入自定义档）：
 *   [预览帧间隔ms, 识别间隔·有目标ms, 识别间隔·空闲ms, 文字识别间隔ms, 水深采样ms, 推理线程]
 * - 三档差异的核心在"节奏"：预览帧率、识别轮询间隔、OCR 间隔与线程数此消彼长，
 *   省电档拉长一切间隔换续航，性能档全面压短换跟手
 * - Index（档位应用/启动对齐）与 PowerSheet（参数展示）共享同一张表；
 *   数组六项与 SettingsStore 的 power* 六个字段顺序一一对应
 */
export const POWER_PRESETS: number[][] = [
  [60, 600, 1500, 4000, 500, 4],   // 0 省电：OCR 静止不跑，移动时 4s 一轮
  [40, 300, 800, 1500, 250, 8],    // 1 标准：OCR 1.5s 一轮，框跟手
  [30, 150, 400, 1000, 150, 8]     // 2 性能：OCR 1s 一轮，最跟手
];

// ★ 档位显示名：与 POWER_PRESETS 下标一一对应（设置页档位选择器/气泡用）
export const POWER_MODE_NAMES: string[] = ['省电', '标准', '性能'];
